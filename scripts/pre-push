#!/usr/bin/env bash
# Local eval gate. Install once:  ln -sf ../../scripts/pre-push .git/hooks/pre-push
#
# Always: unit tests + oracle evals (no model).
# When prompts, agent/model config, actions or eval cases changed: live evals
# against the local model server too. Nothing leaves the machine.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
PY=${PYTHON:-python}

echo "[warden] unit tests + oracle evals"
$PY -m pytest -q
$PY -m evals.run --mode oracle >/dev/null

base=$(git merge-base HEAD '@{upstream}' 2>/dev/null || git rev-list --max-parents=0 HEAD | tail -1)
if ! git diff --name-only "$base" HEAD | grep -qE '^(prompts/|config/|warden/ontology/|evals/)'; then
  echo "[warden] no prompt/config/action/eval changes; skipping live evals"
  exit 0
fi

if [[ "${WARDEN_SKIP_LIVE_EVALS:-}" == "1" ]]; then
  echo "[warden] WARNING: live evals skipped by WARDEN_SKIP_LIVE_EVALS=1" >&2
  exit 0
fi

if ! curl -sf -o /dev/null --noproxy '*' http://127.0.0.1:11434/v1/models; then
  echo "[warden] prompt/config changed but no local model server on 127.0.0.1:11434." >&2
  echo "         Start it (ollama serve) or set WARDEN_SKIP_LIVE_EVALS=1 to push anyway." >&2
  exit 1
fi

echo "[warden] live evals (${WARDEN_EVAL_TRIALS:-3} trials) against local models"
mkdir -p var
$PY -m evals.run --mode live --trials "${WARDEN_EVAL_TRIALS:-3}" --out var/eval-report.json
